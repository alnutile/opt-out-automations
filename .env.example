# --- AI provider ---
ANTHROPIC_API_KEY=

# --- Zapier SDK auth (server-side client credentials) ---
# Generate locally with: npx @zapier/zapier-sdk create-client-credentials
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=

# --- Zapier connection IDs ---
# Get these from `npx @zapier/zapier-sdk` (see README) or the Zapier dashboard.
ZAPIER_IMAP_CONNECTION_ID=
ZAPIER_SMTP_CONNECTION_ID=
ZAPIER_SLACK_CONNECTION_ID=

# --- Zapier Tables ---
OPT_OUTS_TABLE_ID=01KR9CX567CGNYQ53C3ATB0ENF
CUSTOMERS_TABLE_ID=01KR9D59PPC0YQTG4N1CE21VQH

# --- Slack escalation ---
SLACK_REVIEW_CHANNEL=#opt-out-review

# --- Polling ---
POLL_INTERVAL_SECONDS=60

# --- Reply template ---
COMPANY_NAME=DailyAiStudio

# --- SMTP sender ---
# Must be an address the SMTP connection is allowed to send from.
FROM_EMAIL=opt-out@emailautomations.cloud
